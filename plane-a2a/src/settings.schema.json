{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a plane lifecycle settings",
  "anyOf": [
    {
      "$ref": "#/$defs/section"
    },
    {
      "type": "object",
      "properties": {
        "agents": {
          "$ref": "#/$defs/section"
        }
      },
      "additionalProperties": false,
      "required": [
        "agents"
      ]
    }
  ],
  "$defs": {
    "section": {
      "type": "object",
      "properties": {
        "hooks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "upstream_credentials": {
          "const": "own"
        },
        "pools": {
          "description": "Host-injected pools: the reader extracts pool.members entries that are strings or objects with a string name. Missing or malformed pools/members are ignored, preserving its tolerant grammar.",
          "examples": [
            {
              "fallback": {
                "members": [
                  "primary",
                  {
                    "name": "secondary"
                  }
                ]
              }
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._~-]+$",
        "not": {
          "enum": [
            ".",
            ".."
          ]
        }
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^[hH][tT][tT][pP][sS]?://",
          "description": "Lifecycle verifies URL syntax and refuses userinfo."
        },
        "pin": {
          "type": "object",
          "properties": {
            "mechanism": {
              "enum": [
                "jws_issuer_key",
                "cert_spki",
                "mtls",
                "unpinned"
              ]
            },
            "key": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fingerprint": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "mechanism"
          ]
        },
        "client_identity": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "cert": {
                  "$ref": "#/$defs/secret",
                  "x-busbar-secret": true,
                  "writeOnly": true
                },
                "key": {
                  "$ref": "#/$defs/secret",
                  "x-busbar-secret": true,
                  "writeOnly": true
                }
              },
              "additionalProperties": false,
              "required": [
                "cert",
                "key"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reverify_ttl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "5s"
        },
        "recovery_backoff": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "allow_private": {
          "type": "boolean",
          "default": false
        },
        "upstream_credentials": {
          "enum": [
            "own",
            null
          ]
        },
        "upstream_credential": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "secret": {
                  "$ref": "#/$defs/secret",
                  "x-busbar-secret": true,
                  "writeOnly": true
                },
                "placement": {
                  "anyOf": [
                    {
                      "const": "bearer"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "header": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "header"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "bearer": true
                      },
                      "additionalProperties": false,
                      "required": [
                        "bearer"
                      ]
                    }
                  ],
                  "default": "bearer"
                },
                "lease_ttl_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 18446744073709551615,
                  "x-busbar-integer-token": "unsigned"
                }
              },
              "additionalProperties": false,
              "required": [
                "secret",
                "lease_ttl_ms"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "egress_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "default": []
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "url",
        "pin"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "pin": {
                "properties": {
                  "mechanism": {
                    "const": "mtls"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "client_identity"
            ],
            "properties": {
              "client_identity": {
                "type": "object",
                "properties": {
                  "cert": {
                    "$ref": "#/$defs/secret",
                    "x-busbar-secret": true,
                    "writeOnly": true
                  },
                  "key": {
                    "$ref": "#/$defs/secret",
                    "x-busbar-secret": true,
                    "writeOnly": true
                  }
                },
                "additionalProperties": false,
                "required": [
                  "cert",
                  "key"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "client_identity"
            ],
            "properties": {
              "client_identity": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^[hH][tT][tT][pP][sS]://"
              }
            }
          }
        }
      ]
    },
    "secret": {
      "oneOf": [
        {
          "const": "none"
        },
        {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "pattern": "\\S"
            },
            "settings": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "module"
          ]
        },
        {
          "type": "object",
          "properties": {
            "template": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "module": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "setting": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "module",
                    "setting"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "text",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "template"
          ],
          "additionalProperties": false
        }
      ]
    },
    "owned_sections": {
      "description": "PlaneOpenIn.owned / PlaneRefreshIn.owned, separate from the settings argument described by the schema root.",
      "properties": {
        "agent_push": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "ca": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Public CA certificate PEM; not a secret."
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "authored_section": {
      "type": "object",
      "properties": {
        "hooks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "upstream_credentials": {
          "const": "own"
        },
        "pools": false
      },
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._~-]+$",
        "not": {
          "enum": [
            ".",
            ".."
          ]
        }
      },
      "description": "Plane-owned raw agents section grammar; host-injected pools are not writable registration input. Core security/source policy, reserved-name checks, SecretRef resolution and module validation still apply."
    },
    "user_configuration": {
      "type": "object",
      "properties": {
        "agents": {
          "anyOf": [
            {
              "$ref": "#/$defs/authored_section"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null/absent is an unconfigured host section; the host does not pass null as a lifecycle settings object."
        },
        "agent_push": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "ca": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Public CA certificate PEM; not a secret."
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "x-busbar-partial": true,
      "description": "The supported plane-owned blocks within a complete deploy document. This is not a complete host boot schema."
    }
  },
  "description": "Lifecycle agents settings (bare section, or validate envelope). URL validity, TLS compatibility and registration rules are also checked by validate_agent.",
  "x-busbar-settings-profile": "integer-token-v1",
  "x-busbar-user-configuration": {
    "version": 1,
    "context": "raw_user_configuration",
    "schema_ref": "#/$defs/user_configuration",
    "reference_base": "returned_schema_document",
    "roots": [
      "agents",
      "agent_push"
    ],
    "member_schema_refs": {
      "agents": "#/$defs/agent"
    },
    "settings_representation": "raw SecretRef user input; distinct from material resolved for a lifecycle call",
    "host_context": {
      "validation": "Run the canonical host validate/apply path, including semantic security policy, source/config fences, module resolution, reserved names, declared secret paths and runtime acknowledgement/activation receipts.",
      "host_schema": "x-busbar-config-schemas",
      "injected_fields": {
        "agents.pools": "runtime projection only; author the top-level pools block using the host-owned Pools grammar instead"
      },
      "registration_hooks": "host resolves hook names and preserves all unedited private values; module fields do not confer mutation authority"
    },
    "edit": {
      "section_route": "PUT /api/v1/admin/config/settings document_patch",
      "definition_route": "PUT /api/v1/admin/agents/{name}",
      "partial_edit": "Use canonical source-fenced document edits or the named settings edit operation; never reconstruct a replacement from sanitized readback.",
      "generation_binding": "Use the returned canonical module/kind/version, declaration source and archive digest if supplied; installed schema is not proof of activation."
    },
    "runtime_validation": [
      "actual parser, URL/duration and cross-field requirements",
      "module capability and current host admission policy",
      "native source-bound validation/apply is authoritative"
    ],
    "read_only_or_unsupported": {
      "agents.*.egress_scopes": "nonempty is refused because enforcement is not implemented"
    }
  }
}
